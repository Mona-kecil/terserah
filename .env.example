# Copy to .env and fill in. Never commit .env.

# --- Telegram -------------------------------------------------------------
# One bot per person, plus one moderator bot. Create each with @BotFather
# (/newbot), then give each person the link to their own bot only.

# The neutral moderator: puts options on the table, hands back the final three.
TELEGRAM_TOKEN_MAIN=

# One per delegate. The person DMs their own bot to brief it privately.
TELEGRAM_TOKEN_BUDI=
TELEGRAM_TOKEN_MAWAR=
TELEGRAM_TOKEN_JOKO=
TELEGRAM_TOKEN_DIMAS=

# --- LLM ------------------------------------------------------------------
# Recommended: DeepSeek. Cheapest current frontier-class API, strong Bahasa
# Indonesia, and OpenAI-compatible so nothing else changes.
# Sign up: https://platform.deepseek.com -> API Keys
# A full 5-agent, 3-turn session costs well under one US cent.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# SumoPod (Indonesian cloud provider with an AI gateway: OpenAI, Claude, GLM,
# Kimi, DeepSeek). Their base URL and model ids are not publicly documented -
# copy both from the SumoPod dashboard, then verify with:  python probe.py
# LLM_BASE_URL=<from dashboard, usually ends in /v1>
# LLM_MODEL=<copy the exact model id>

# Alternative: OpenRouter (one key, many models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat

# Alternative: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Alternative: local, free, no key at all (needs a decent machine)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
